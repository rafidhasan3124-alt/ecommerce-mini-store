# Database (SQLite for development, PostgreSQL recommended for production)
DATABASE_URL="file:./dev.db"

# JWT Secret (Generate a strong random string in production)
JWT_SECRET="your_jwt_secret_here"

# Admin Emails (comma-separated, no spaces)
# Users who register with these emails will automatically get the ADMIN role
ADMIN_EMAILS="admin@example.com"

# Stripe (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_KEY_HERE"
STRIPE_SECRET_KEY="sk_test_YOUR_KEY_HERE"

# App URL (Change to your deployed URL in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
